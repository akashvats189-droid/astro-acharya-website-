---
import Base from '../layouts/Base.astro';
---

<Base title="Home - Astro Acharya">
  <main>
    <h1>Welcome to Astro Acharya</h1>
    <p>Vedic Karmkand Services</p>
  </main>
</Base>

<style>
  main {
    margin: auto;
    padding: 1rem;
    width: 800px;
    max-width: calc(100% - 2rem);
    color: white;
    font-size: 20px;
    line-height: 1.6;
  }
  h1 {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    margin-bottom: 1em;
  }
</style>
