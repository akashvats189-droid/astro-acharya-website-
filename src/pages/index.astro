---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Vedic Karmkand - Home">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold text-secondary mb-4">Welcome to Vedic Karmkand</h1>
      <p class="text-xl text-gray-600 mb-8">Authentic rituals and ceremonies performed by experienced pandits</p>
      <a href="/services" class="bg-accent text-white px-8 py-3 rounded-lg hover:bg-secondary transition inline-block">
        Explore Services
      </a>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <div class="bg-white p-8 rounded-lg shadow">
        <div class="text-4xl mb-4">🙏</div>
        <h3 class="text-xl font-bold text-secondary mb-2">Authentic Rituals</h3>
        <p class="text-gray-600">Traditional Vedic ceremonies performed according to ancient texts and practices.</p>
      </div>
      <div class="bg-white p-8 rounded-lg shadow">
        <div class="text-4xl mb-4">👨‍🎓</div>
        <h3 class="text-xl font-bold text-secondary mb-2">Expert Pandits</h3>
        <p class="text-gray-600">Highly trained and experienced spiritual guides with decades of knowledge.</p>
      </div>
      <div class="bg-white p-8 rounded-lg shadow">
        <div class="text-4xl mb-4">📅</div>
        <h3 class="text-xl font-bold text-secondary mb-2">Easy Booking</h3>
        <p class="text-gray-600">Simple online booking system to schedule your ceremonies at your convenience.</p>
      </div>
    </section>
  </div>
</Layout>
